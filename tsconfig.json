{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "allowUnreachableCode": false,
    // "noUncheckedIndexedAccess": true,
    // "noPropertyAccessFromIndexSignature": true,
    "plugins": [
      {
        "name": "next",
      },
    ],
    "paths": {
      "@/*": [
        "./src/*",
      ],
      // For files outside src/ (e.g. i18n.config). Unlike escaping @/ with "@/../",
      // this expands without a ".." segment, which tsx (used by the seed scripts) resolves.
      "@root/*": [
        "./*",
      ],
      "@PRISMA-NAMESPACE-ONLY": [
        "./prisma/generated/client",
      ],
    },
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
  ],
  "exclude": [
    "prisma/generated/**/*",
    "node_modules",
    ".claude",
    "ignore",
  ],
}
