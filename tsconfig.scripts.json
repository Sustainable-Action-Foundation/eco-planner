{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@prisma": [
        "./src/prisma/generated"
      ]
    },
    "resolveJsonModule": true,
  },
  "include": [
    "./scripts/*.ts"
  ],
}