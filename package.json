{
  "name": "eco-planner",
  "version": "0.17.4",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "A tool intended to help planning actions to achieve local environmental goals",
  "homepage": "https://github.com/Sustainable-Action-Foundation/eco-planner/",
  "bugs": "https://github.com/Sustainable-Action-Foundation/eco-planner/issues/",
  "repository": "github:Sustainable-Action-Foundation/eco-planner/",
  "scripts": {
    "preinstall": "git update-index --skip-worktree src/lib/LEAPList.json &",
    "dev": "yarn lint & yarn next dev",
    "pre-build": "yarn lint",
    "build": "yarn pre-build && yarn next build",
    "start": "next start",
    "lint": "tsc --noEmit -p ./tsconfig.json && eslint -c ./eslint.config.ts",
    "check:version": "tsx scripts/checkVersionBump.ts",
    "check:locales": "tsx scripts/findDeadLocaleKeys.ts",
    "test": "yarn test:unit & yarn test:e2e",
    "test:e2e": "playwright test -c tests/playwright.e2e.config.ts",
    "test:unit": "playwright test -c tests/playwright.unit.config.ts",
    "test:screenshot": "playwright test -c tests/playwright.screenshot.config.ts",
    "docker:up": "docker compose -f docker/compose.staging.yaml --env-file docker/.env.local up -d --build",
    "docker:down": "docker compose -f docker/compose.staging.yaml --env-file docker/.env.local down"
  },
  "author": {
