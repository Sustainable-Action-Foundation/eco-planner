{
  "name": "eco-planner",
  "version": "0.15.5",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "A tool intended to help planning actions to achieve local environmental goals",
  "homepage": "https://github.com/Sustainable-Action-Foundation/eco-planner",
  "bugs": "https://github.com/Sustainable-Action-Foundation/eco-planner/issues",
  "repository": "github:Sustainable-Action-Foundation/eco-planner",
  "scripts": {
    "preinstall": "git update-index --skip-worktree src/lib/LEAPList.json &",
    "predev": "tsx ./src/scripts/getBuildInfo.ts",
    "dev": "next dev --turbopack",
    "prebuild": "tsx ./src/scripts/generateLeapList.ts && tsx ./src/scripts/getDataSeriesValueFieldNames.ts && tsx ./src/scripts/getBuildInfo.ts",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit && eslint ./src",
    "locales:format": "tsx ./src/scripts/localesFormat.ts",
    "test:run": "tsx ./tests/run.ts",
    "test:clean": "rm -rf test-results & rm -rf playwright-report & rm tests/report.json & rm tests/reporter.log",
    "docker:up": "docker compose -f docker/compose.staging.yaml --env-file docker/.env.local up -d --build",
    "docker:down": "docker compose -f docker/compose.staging.yaml --env-file docker/.env.local down"
  },
  "author": {
    "name": "Sustainable Action Foundation",
    "email": "info@sustainable-action.org",
    "url": "https://sustainable-action.org"
  },
  "contributors": [
    {
      "name": "Noëlle Lööv",
      "email": "noelle.loov@sustainable-action.org"
    },
    {
      "name": "Axel Schnürer",
      "email": "axel.schnurer@sustainable-action.org"
    },
    {
      "name": "Jesper Cejie",
      "email": "jesper@cejie.se",
      "url": "https://jesper.cejie.se"
    },
    {
      "name": "Vena Ström",
      "email": "vena.strom@sustainable-action.org",
      "url": "https://venastrom.se/"
    }
  ],
  "type": "module",
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@formatjs/intl-localematcher": "^0.7.2",
    "@prisma/client": "^6.15.0",
    "@tabler/icons-react": "^3.36.0",
    "@tiptap/core": "^3.14.0",
    "@tiptap/extension-bubble-menu": "^3.14.0",
    "@tiptap/extension-character-count": "^3.14.0",
    "@tiptap/extension-document": "^3.14.0",
    "@tiptap/extension-hard-break": "^3.14.0",
    "@tiptap/extension-highlight": "^3.14.0",
    "@tiptap/extension-link": "^3.14.0",
    "@tiptap/extension-list": "^3.14.0",
    "@tiptap/extension-paragraph": "^3.14.0",
    "@tiptap/extension-subscript": "^3.14.0",
    "@tiptap/extension-superscript": "^3.14.0",
    "@tiptap/extension-text": "^3.14.0",
    "@tiptap/extension-text-style": "^3.14.0",
    "@tiptap/extensions": "^3.14.0",
    "@tiptap/pm": "^3.14.0",
    "@tiptap/react": "^3.14.0",
    "accept-language": "^3.0.20",
    "apexcharts": "^5.3.6",
    "bcryptjs": "^3.0.3",
    "client-only": "^0.0.1",
    "cookies-next": "^6.1.1",
    "dotenv": "^17.2.3",
    "fuse.js": "^7.1.0",
    "glob": "^13.0.0",
    "i18next": "^25.7.3",
    "i18next-fs-backend": "^2.6.1",
    "i18next-http-backend": "^3.0.2",
    "iron-session": "^8.0.4",
    "mathjs": "^15.1.0",
    "next": "^15.5.9",
    "nodemailer": "^7.0.11",
    "react": "^19.2.3",
    "react-apexcharts": "^1.9.0",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.0",
    "server-only": "^0.0.1",
    "use-debounce": "^10.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/regexp.escape": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.9",
    "lorem-ipsum": "^2.0.8",
    "playwright": "^1.57.0",
    "pocketbase": "^0.26.5",
    "prisma": "^6.15.0",
    "regexp.escape": "^2.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">v22.7.0",
      "onFail": "warn"
    }
  },
  "packageManager": "yarn@1.22.22"
}
