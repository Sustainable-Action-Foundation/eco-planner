generator client {
  provider     = "prisma-client"
  moduleFormat = "esm"
  output       = "./generated"
}

datasource db {
  provider = "mysql"
}

enum RoadmapType {
  NATIONAL
  REGIONAL
  MUNICIPAL
  LOCAL
  ORGANIZATIONAL
  OTHER
}

enum ActionImpactType {
  // Change in percent of the previous year's baseline + actions
  PERCENT
  // Absolute difference from baseline
  ABSOLUTE
  // Change from previous year, if year 1 and 2 both have a value of 10, the total value for year 2 will be 20
  DELTA
}

enum AccessLevel {
  RO // Read-Only
  RW // Read-Write
}

enum OrgRole {
  // Guests are cross-org contributors: they do NOT get org_readable read access, only what their groups explicitly grant (plus public content)
  GUEST
  MEMBER
  // Managers bypass all access grants under their org and manage its groups and sharing settings.
  // For the time being managers are not a fine grained role, they have full access to everything in the org and group management.
  // This is a choice until actual usage requires more fine grained management.
  MANAGER
}

// How an ActionFields value should be interpreted and rendered. The value itself
// is always stored as a string; this only informs the UI (input widget, display).
// List-ness is structural, not typed: multiple fields sharing a header collapse
// into a list in the UI when their type supports it (i.e. is not PARAGRAPH).
enum ActionFieldType {
  PARAGRAPH
  DATE
  SHORT
}

enum GeoAreaType {
  NATION
  COUNTY
  MUNICIPALITY
}

// Static lookup of Swedish geo areas, keyed by SCB region code:
// "00" = Riket, "01".."25" = counties, 4-digit codes = municipalities
// (whose first two digits are their county's code).
model GeoAreas {
  code String      @id
  // Not @unique: the db collation (utf8mb4_unicode_ci) equates å/a, so "Habo" and "Håbo" would collide
  name String
  type GeoAreaType

  parent_code String?
  parent      GeoAreas?  @relation("geo_tree", fields: [parent_code], references: [code])
  children    GeoAreas[] @relation("geo_tree")

  roadmaps Roadmaps[]
  orgs     Orgs[]

  @@index([name])
}

// The highest level of roadmaps, referencing multiple iterations (versions) of itself
model Roadmaps {
  id            String      @id @default(uuid())
  name          String
  description   String      @db.Text
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  // The target of this roadmap as a free-text display label, for example a country, region, municipality or organization
  actor         String?
  // Structured geo marker for the target area; `actor` remains the display label for non-geo targets
  geo_area_code String?
  geo_area      GeoAreas?   @relation(fields: [geo_area_code], references: [code], onDelete: SetNull)
  // The type of roadmap, for example national, regional, or local
  type          RoadmapType @default(OTHER)

  // The different versions of the roadmap
  iterations        RoadmapIterations[] @relation("roadmap_iterations")
  // Roadmaps relate to each other in tree structures
  parent_roadmap_id String?
  parent_roadmap    Roadmaps?           @relation("roadmap_tree", fields: [parent_roadmap_id], references: [id], onDelete: SetNull)
  child_roadmaps    Roadmaps[]          @relation("roadmap_tree")

  // Comments related to this roadmap
  comments Comments[] @relation("roadmap_comments")

  // Author of this roadmap, used for visual purposes only, not for access control
  author_id String?
  author    Users?  @relation("roadmap_author", fields: [author_id], references: [id], onDelete: SetNull)

  // Access control for this roadmap and all of its iterations
  access_control_id String
  access_control    AccessControls @relation(fields: [access_control_id], references: [id])
}

model RoadmapIterations {
  // UUID of the roadmap iteration
  id          String   @id @default(uuid())
  // Timestamp of when the iteration was created
  created_at  DateTime @default(now())
  // Timestamp of when the iteration was last updated
  updated_at  DateTime @updatedAt
  // Optional description of this specific iteration
  description String?  @db.Text

  // The roadmap this is an iteration of
  roadmap_id     String
  roadmap        Roadmaps  @relation("roadmap_iterations", fields: [roadmap_id], references: [id], onDelete: Cascade)
  // The version of the roadmap
  version        Int
  // If the parent roadmap relates to another roadmap, target_version defines which version of the related roadmap this iteration relates to
  // If target version is not found in the related roadmap, use the latest version available instead
  target_version Int?
  // When this iteration was published; null means draft, visible only to users with RW access (or better) via the roadmap's access control
  published_at   DateTime?

  comments Comments[] @relation("roadmap_iteration_comments")
  goals    Goals[]    @relation("roadmap_iteration_goals")
  actions  Actions[]  @relation("roadmap_iteration_actions")

  // Author of this iteration, used for visual purposes only, not for access control
  author_id String?
  author    Users?  @relation("roadmap_iteration_author", fields: [author_id], references: [id], onDelete: SetNull)

  // Two iterations may not have the same roadmap AND version
  // Also allows for querying an iteration by roadmap and version
  @@unique(name: "roadmap_version", [roadmap_id, version])
}

model Goals {
  // UUID of the goal
  id         String   @id @default(uuid())
  // Timestamp of when goal was created
  created_at DateTime @default(now())
  // Timestamp of when goal was last updated
  updated_at DateTime @updatedAt

  // Name of goal
  // If no name is given, show indicator parameter instead
  name                String?
  // Longer description of goal
  description         String? @db.Text
  // Will be something similar to "Key\Energiomvandlingsanläggningar\Insatta bränslen för elproduktion\Naturgas", as defined by LEAP
  indicator_parameter String  @db.Text

  // The graphs of featured Goals' DataSeries will be shown as thumbnails on the roadmap page
  is_featured Boolean @default(false)

  // A series of data points representing the goals for each year
  data_series_id String?     @unique
  data_series    DataSeries? @relation(name: "goal_data_series", fields: [data_series_id], references: [id])
  // A series of data points serving as a "baseline" where no action is taken
  baseline_id    String?     @unique
  baseline       DataSeries? @relation(name: "goal_baseline", fields: [baseline_id], references: [id])
  // Goals may use historical data to plot in comparison to the planned data series
  historical_id  String?     @unique
  historical     DataSeries? @relation(name: "goal_historical", fields: [historical_id], references: [id])

  // When inheriting data from this goal, these suggestions will appear for the user to choose from e.g. "Scale by area" or "Scale by population"
  recipe_suggestions Recipes[] @relation("inheritance_suggestions")

  // Comments related to this goal
  comments Comments[] @relation("goal_comments")
  // Tags for this goal
  // Tags are used to categorize goals, such as "climate", "energy", "transport", etc.
  tags     GoalTags[] @relation("goal_tags")

  // Author of this goal, used for visual purposes only, not for access control
  author_id String?
  author    Users?  @relation("goal_author", fields: [author_id], references: [id], onDelete: SetNull)

  // Effects affecting this goal
  effects              Effects[]         @relation("goal_effects")
  // Parent roadmap iteration
  roadmap_iteration_id String
  roadmap_iteration    RoadmapIterations @relation("roadmap_iteration_goals", fields: [roadmap_iteration_id], references: [id], onDelete: Cascade)
}

model DataSeries {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  org_id String
  org    Orgs   @relation(fields: [org_id], references: [id], onDelete: Cascade)

  // The user who created this data series, used for visual purposes only, not for access control
  author_id String?
  author    Users?  @relation("data_series_author", fields: [author_id], references: [id], onDelete: SetNull)

  // An empty string indicates a missing unit, while null indicates an intentionally unitless data series, such as an amount of electric cars
  unit   String?       @default("")
  values DateRecords[]

  // Every data series is produced by exactly one recipe; manual input uses an inline recipe (meta.isManual)
  recipe_used_id    String    @unique
  recipe_used       Recipes   @relation(name: "recipe_used", fields: [recipe_used_id], references: [id])
  dependent_recipes Recipes[] @relation(name: "source_data_series")

  // A data series belongs to at most one dependent slot (unique FKs on the other side).
  // A series filling multiple slots at once (e.g. one goal's data_series and another goal's baseline) has to be prevented in code.
  dependent_goal       Goals?   @relation("goal_data_series")
  dependent_baseline   Goals?   @relation("goal_baseline")
  dependent_historical Goals?   @relation("goal_historical")
  dependent_effect     Effects? @relation("effect_data_series")
}

model DateRecords {
  timestamp      DateTime   @db.Date
  value          Float
  data_series_id String
  data_series    DataSeries @relation(fields: [data_series_id], references: [id], onDelete: Cascade)

  @@id([data_series_id, timestamp])
}

model Recipes {
  id     String @id @default(uuid())
  recipe Json   @db.Json

  org_id String
  org    Orgs   @relation(fields: [org_id], references: [id], onDelete: Cascade)

  suggested_by_goals Goals[] @relation("inheritance_suggestions")

  // The one data series this recipe produces; null for recipes not (yet) attached to a series, e.g. inheritance suggestion templates
  derived_data_series DataSeries?  @relation("recipe_used")
  source_data_series  DataSeries[] @relation("source_data_series")
}

model GoalTags {
  // The name of a tag is used as the ID, since it doesn't make sense to have multiple different tags with the same name
  name String @id

  // Goals that are tagged with this tag
  goals Goals[] @relation("goal_tags")
}

model Actions {
  // UUID of the action
  id         String   @id @default(uuid())
  // Timestamp of when action was created
  created_at DateTime @default(now())
  // Timestamp of when action was last updated
  updated_at DateTime @updatedAt

  org_id String
  org    Orgs   @relation(fields: [org_id], references: [id], onDelete: Cascade)

  // Name of action, preferably a short summary
  name                String
  // Used to create a tree structure for actions, looks like "Some\Tree\Structure"
  indicator_parameter String @db.VarChar(1024)
  // The year the action is planned to start
  start_year          Int?
  // The year the action is planned to end
  end_year            Int?

  // Effects of this action
  effects Effects[] @relation("action_effects")

  roadmap_iteration_id String?
  roadmap_iteration    RoadmapIterations? @relation("roadmap_iteration_actions", fields: [roadmap_iteration_id], references: [id], onDelete: Cascade)

  // Relations for keeping track of inheritance between actions
  parent_action_id String?
  parent_action    Actions?  @relation("action_inheritance", fields: [parent_action_id], references: [id], onDelete: SetNull)
  child_actions    Actions[] @relation("action_inheritance")

  // Comments related to this action
  comments Comments[] @relation("action_comments")

  // The user who created this action, used for visual purposes only, not for access control
  author_id String?
  author    Users?  @relation("action_author", fields: [author_id], references: [id], onDelete: SetNull)

  fields ActionFields[] @relation("action_fields")
}

model ActionFields {
  id String @id @default(uuid())

  // The action this field belongs to
  action_id String
  action    Actions @relation("action_fields", fields: [action_id], references: [id], onDelete: Cascade)

  header String          @db.TinyText
  value  String          @db.Text
  type   ActionFieldType @default(PARAGRAPH)
}

// Effects are the connection between an action and a goal, showing how the action affects the goal
model Effects {
  // Timestamp of when effect was created
  created_at DateTime @default(now())
  // Timestamp of when effect was last updated
  updated_at DateTime @updatedAt

  // Data series representing the impact of the related action on the goal, year by year
  data_series_id String?     @unique
  data_series    DataSeries? @relation(name: "effect_data_series", fields: [data_series_id], references: [id])

  // The type of impact this action has, affects how the data series is interpreted
  impact_type ActionImpactType @default(ABSOLUTE)

  // The action this effect is related to
  action_id String
  action    Actions @relation("action_effects", fields: [action_id], references: [id], onDelete: Cascade)
  // The goal this effect is related to
  goal_id   String
  goal      Goals   @relation("goal_effects", fields: [goal_id], references: [id], onDelete: Cascade)

  @@id(name: "id", [action_id, goal_id])
}

// There is apparently a default typescript interface called "Comment", so make sure to properly import this type in the code
model Comments {
  // UUID of the comment
  id         String   @id @default(uuid())
  // Timestamp of when comment was created
  created_at DateTime @default(now())
  // Timestamp of when comment was last updated
  updated_at DateTime @updatedAt

  // The comment itself
  comment_text String @db.Text

  // The user who created this comment
  author_id String?
  author    Users?  @relation("comment_author", fields: [author_id], references: [id], onDelete: SetNull)

  // A comment should be related to either an action, a goal, a roadmap iteration, XOR a roadmap.
  // Has to be enforced in the code, as prisma does not support custom constraints and many SQL implementations
  // do not support check constraints on columns with referential actions.
  // Any action this comment is related to
  action_id            String?
  action               Actions?           @relation("action_comments", fields: [action_id], references: [id], onDelete: Cascade)
  // Any goal this comment is related to
  goal_id              String?
  goal                 Goals?             @relation("goal_comments", fields: [goal_id], references: [id], onDelete: Cascade)
  // Any roadmap iteration this comment is related to
  roadmap_iteration_id String?
  roadmap_iteration    RoadmapIterations? @relation("roadmap_iteration_comments", fields: [roadmap_iteration_id], references: [id], onDelete: Cascade)
  // Any roadmap this comment is related to
  roadmap_id           String?
  roadmap              Roadmaps?          @relation("roadmap_comments", fields: [roadmap_id], references: [id], onDelete: Cascade)
}

model Orgs {
  id     String  @id @default(uuid())
  name   String  @unique
  domain String? @unique

  // Structured geo marker for where the org operates; null for non-geographic orgs
  geo_area_code String?
  geo_area      GeoAreas? @relation(fields: [geo_area_code], references: [code], onDelete: SetNull)

  memberships     OrgMemberships[]
  groups          Groups[]         @relation("org_groups")
  access_controls AccessControls[]

  data_series DataSeries[]
  recipes     Recipes[]
  actions     Actions[]
}

model Groups {
  id   String @id @default(uuid())
  name String

  org_id String
  org    Orgs   @relation("org_groups", fields: [org_id], references: [id], onDelete: Cascade)

  memberships GroupMemberships[]
  grants      AccessGrants[]

  @@unique([org_id, name]) // Unique group names within an org
  // Referenced by GroupMemberships' composite FK to keep group and org membership in the same org
  @@unique([id, org_id])
}

// A user's membership in an org; group memberships hang off this so they die with it
model OrgMemberships {
  id String @id @default(uuid())

  user_id String
  user    Users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  org_id  String
  org     Orgs   @relation(fields: [org_id], references: [id], onDelete: Cascade)

  role OrgRole @default(MEMBER)

  group_memberships GroupMemberships[]

  @@unique([user_id, org_id]) // No dupe memberships for the same user in the same org
  // Referenced by GroupMemberships' composite FK
  @@unique([id, org_id])
}

// Membership in a group, tied to an org membership rather than a user directly:
// leaving the org cascades away all group memberships in it, and the shared org_id
// in both composite FKs makes cross-org group membership unrepresentable
model GroupMemberships {
  membership_id String
  org_id        String
  group_id      String

  membership OrgMemberships @relation(fields: [membership_id, org_id], references: [id, org_id], onDelete: Cascade)
  group      Groups         @relation(fields: [group_id, org_id], references: [id, org_id], onDelete: Cascade)

  @@id([membership_id, group_id])
}

model AccessControls {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // The org that owns the attached items; its managers have implicit full access
  org_id String
  org    Orgs   @relation(fields: [org_id], references: [id], onDelete: Cascade)

  // If public, it grants read access to everyone (account or not) regardless of grants
  is_public    Boolean @default(false)
  // If org readable, all members of the owning org get read access; disable together with is_public for org-internal need-to-know objects
  org_readable Boolean @default(true)

  grants AccessGrants[]

  roadmaps Roadmaps[]

  // Referenced by AccessGrants' composite FK to keep grants within the owning org
  @@unique([id, org_id])
}

// Grants all members of a group an access level on the objects attached to an access control.
// Both composite FKs carry org_id, so a grant can only pair a group and an access control from the same org;
// cross-org contributors instead get a GUEST org membership and a spot in a group of the owning org.
model AccessGrants {
  access_control_id String
  group_id          String
  org_id            String

  access_control AccessControls @relation(fields: [access_control_id, org_id], references: [id, org_id], onDelete: Cascade)
  group          Groups         @relation(fields: [group_id, org_id], references: [id, org_id], onDelete: Cascade)

  access_level AccessLevel @default(RO)

  @@id([access_control_id, group_id])
}

model Users {
  id            String  @id @default(uuid())
  username      String  @unique
  email         String  @unique
  password_hash String
  is_verified   Boolean @default(false) // Has verified email

  is_super_admin Boolean @default(false)

  memberships OrgMemberships[]

  // Authorship (purely visual/cool to know, not auth)
  authored_actions            Actions[]           @relation("action_author")
  authored_goals              Goals[]             @relation("goal_author")
  authored_roadmap_iterations RoadmapIterations[] @relation("roadmap_iteration_author")
  authored_roadmaps           Roadmaps[]          @relation("roadmap_author")
  authored_data_series        DataSeries[]        @relation("data_series_author")
  authored_comments           Comments[]          @relation("comment_author")
}
