generator client {
  provider     = "prisma-client"
  moduleFormat = "esm"
  output       = "./generated"
}

datasource db {
  provider = "mysql"
}

enum RoadmapType {
  NATIONAL
  REGIONAL
  MUNICIPAL
  LOCAL
  ORGANIZATIONAL
  OTHER
}

enum ActionImpactType {
  // Change in percent of the previous year's baseline + actions
  PERCENT
  // Absolute difference from baseline
  ABSOLUTE
  // Change from previous year, if year 1 and 2 both have a value of 10, the total value for year 2 will be 20
  DELTA
}

enum AccessLevel {
  RO // Read-Only
  RW // Read-Write
}

enum OrgRole {
  // Guests are cross-org contributors: they do NOT get orgReadable read access, only what their groups explicitly grant (plus public content)
  GUEST
  MEMBER
  // Managers bypass all access grants under their org and manage its groups and sharing settings.
  // For the time being managers are not a fine grained role, they have full access to everything in the org and group management.
  // This is a choice until actual usage requires more fine grained management.
  MANAGER
}

// Meta roadmaps are used for the highest level of roadmaps and reference multiple versions of the same roadmap
model MetaRoadmap {
  id          String      @id @default(uuid())
  name        String
  description String      @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  // The target of this roadmap, for example a country, region, municipality or organization
  actor       String?
  // The type of roadmap, for example national, regional, or local
  type        RoadmapType @default(OTHER)

  // The different versions of the roadmap
  iterations      Roadmap[]     @relation("meta_roadmap")
  // Meta roadmaps relate to each other in tree structures
  parentRoadmapId String?       @map("parent_roadmap_id")
  parentRoadmap   MetaRoadmap?  @relation("meta_roadmap_relation", fields: [parentRoadmapId], references: [id], onDelete: SetNull)
  childRoadmaps   MetaRoadmap[] @relation("meta_roadmap_relation")

  // Comments related to this meta roadmap
  comments Comment[] @relation("meta_roadmap_comment")

  // Author of this meta roadmap, used for visual purposes only, not for access control
  authorId String? @map("author_id")
  author   User?   @relation("meta_roadmap_author", fields: [authorId], references: [id], onDelete: SetNull)

  // Access control for this meta roadmap and all of its iterations
  accessControlId String        @map("access_control_id")
  accessControl   AccessControl @relation(fields: [accessControlId], references: [id])

  @@map("meta_roadmap")
}

model Roadmap {
  // UUID of the roadmap
  id          String   @id @default(uuid())
  // Timestamp of when roadmap was created
  createdAt   DateTime @default(now()) @map("created_at")
  // Timestamp of when roadmap was last updated
  updatedAt   DateTime @updatedAt @map("updated_at")
  // Optional description of this specific roadmap version
  description String?  @db.Text

  // Parent meta roadmap
  // This is the meta roadmap that this roadmap is a version of
  metaRoadmapId String      @map("meta_roadmap_id")
  metaRoadmap   MetaRoadmap @relation("meta_roadmap", fields: [metaRoadmapId], references: [id], onDelete: Cascade)
  // The version of the roadmap
  version       Int
  // If the parent meta roadmap relates to another meta roadmap, targetVersion defines which version of the related meta roadmap this roadmap version relates to
  // If target version is not found in the related meta roadmap, use the latest version available instead
  targetVersion Int?        @map("target_version")
  // When this version was published; null means draft, visible only to users with RW access (or better) via the meta roadmap's access control
  publishedAt   DateTime?   @map("published_at")

  comments Comment[] @relation("roadmap_comment")
  goals    Goal[]    @relation("roadmap_goal")
  actions  Action[]  @relation("action_roadmap")

  // Author of this roadmap, used for visual purposes only, not for access control
  authorId String? @map("author_id")
  author   User?   @relation("roadmap_author", fields: [authorId], references: [id], onDelete: SetNull)

  // Two roadmaps may not have the same meta roadmap AND version
  // Also allows for querying a roadmap by meta roadmap and version
  @@unique(name: "meta_version", [metaRoadmapId, version])
  @@map("roadmap")
}

model Goal {
  // UUID of the goal
  id        String   @id @default(uuid())
  // Timestamp of when goal was created
  createdAt DateTime @default(now()) @map("created_at")
  // Timestamp of when goal was last updated
  updatedAt DateTime @updatedAt @map("updated_at")

  // Name of goal
  // If no name is given, show indicator parameter instead
  name               String?
  // Longer description of goal
  description        String? @db.Text
  // Will be something similar to "Key\Energiomvandlingsanläggningar\Insatta bränslen för elproduktion\Naturgas", as defined by LEAP
  indicatorParameter String  @map("indicator_parameter") @db.Text

  // The graphs of featured Goals' DataSeries will be shown as thumbnails on the roadmap page
  isFeatured Boolean @default(false) @map("is_featured")

  // A series of data points representing the goals for each year
  dataSeriesId String?     @unique @map("data_series_id")
  dataSeries   DataSeries? @relation(name: "goal_data_series", fields: [dataSeriesId], references: [id])
  // A series of data points serving as a "baseline" where no action is taken
  baselineId   String?     @unique @map("baseline_id")
  baseline     DataSeries? @relation(name: "goal_baseline", fields: [baselineId], references: [id])
  // Goals may use historical data to plot in comparison to the planned data series
  historicalId String?     @unique @map("historical_id")
  historical   DataSeries? @relation(name: "goal_historical", fields: [historicalId], references: [id])

  // When inheriting data from this goal, these suggestions will appear for the user to choose from e.g. "Scale by area" or "Scale by population"
  recipeSuggestions Recipe[] @relation("inheritance_suggestions")

  // Comments related to this goal
  comments Comment[] @relation("goal_comment")
  // Tags for this goal
  // Tags are used to categorize goals, such as "climate", "energy", "transport", etc.
  tags     GoalTag[] @relation("goal_tag")

  // Author of this goal, used for visual purposes only, not for access control
  authorId String? @map("author_id")
  author   User?   @relation("goal_author", fields: [authorId], references: [id], onDelete: SetNull)

  // Effects affecting this goal
  effects   Effect[] @relation("goal_effect")
  // Parent Roadmap
  roadmapId String   @map("roadmap_id")
  roadmap   Roadmap  @relation("roadmap_goal", fields: [roadmapId], references: [id], onDelete: Cascade)

  @@map("goal")
}

model DataSeries {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The user who created this data series, used for visual purposes only, not for access control
  authorId String? @map("author_id")
  author   User?   @relation("data_series_author", fields: [authorId], references: [id], onDelete: SetNull)

  // An empty string indicates a missing unit, while null indicates an intentionally unitless data series, such as an amount of electric cars
  unit   String?      @default("")
  values DateRecord[]

  // Every data series is produced by exactly one recipe; manual input uses an inline recipe (meta.isManual)
  recipeUsedId     String   @unique @map("recipe_used_id")
  recipeUsed       Recipe   @relation(name: "recipe_used", fields: [recipeUsedId], references: [id])
  dependentRecipes Recipe[] @relation(name: "source_data_series")

  // A data series belongs to at most one dependent slot (unique FKs on the other side).
  // A series filling multiple slots at once (e.g. one goal's dataSeries and another goal's baseline) has to be prevented in code.
  dependentGoal       Goal?   @relation("goal_data_series")
  dependentBaseline   Goal?   @relation("goal_baseline")
  dependentHistorical Goal?   @relation("goal_historical")
  dependentEffect     Effect? @relation("effect_data_series")

  @@map("data_series")
}

model DateRecord {
  timestamp    DateTime   @db.Date
  value        Float
  dataSeriesId String     @map("data_series_id")
  dataSeries   DataSeries @relation(fields: [dataSeriesId], references: [id], onDelete: Cascade)

  @@id([dataSeriesId, timestamp])
  @@map("date_record")
}

model Recipe {
  id     String @id @default(uuid())
  recipe Json   @db.Json

  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  suggestedByGoals Goal[] @relation("inheritance_suggestions")

  // The one data series this recipe produces; null for recipes not (yet) attached to a series, e.g. inheritance suggestion templates
  derivedDataSeries DataSeries?  @relation("recipe_used")
  sourceDataSeries  DataSeries[] @relation("source_data_series")

  @@map("recipe")
}

model GoalTag {
  // The name of a tag is used as the ID, since it doesn't make sense to have multiple different tags with the same name
  name String @id

  // Goals that are tagged with this tag
  goals Goal[] @relation("goal_tag")

  @@map("goal_tag")
}

model Action {
  // UUID of the action
  id        String   @id @default(uuid())
  // Timestamp of when action was created
  createdAt DateTime @default(now()) @map("created_at")
  // Timestamp of when action was last updated
  updatedAt DateTime @updatedAt @map("updated_at")

  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Name of action, preferably a short summary
  name               String
  // Used to create a tree structure for actions, looks like "Some\Tree\Structure"
  indicatorParameter String @map("indicator_parameter") @db.VarChar(1024)
  // The year the action is planned to start
  startYear          Int?   @map("start_year")
  // The year the action is planned to end
  endYear            Int?   @map("end_year")

  // Effects of this action
  effects Effect[] @relation("action_effect")

  roadmapId String?  @map("roadmap_id")
  roadmap   Roadmap? @relation("action_roadmap", fields: [roadmapId], references: [id], onDelete: Cascade)

  // Relations for keeping track of inheritance between actions
  parentActionId String?  @map("parent_action_id")
  parentAction   Action?  @relation("action_inheritance", fields: [parentActionId], references: [id], onDelete: SetNull)
  childActions   Action[] @relation("action_inheritance")

  // Comments related to this action
  comments Comment[] @relation("action_comment")

  // The user who created this action, used for visual purposes only, not for access control
  authorId String? @map("author_id")
  author   User?   @relation("action_author", fields: [authorId], references: [id], onDelete: SetNull)

  fields ActionField[] @relation("action_fields")

  @@map("action")
}

model ActionField {
  id String @id @default(uuid())

  // The action this field belongs to
  actionId String @map("action_id")
  action   Action @relation("action_fields", fields: [actionId], references: [id], onDelete: Cascade)

  header String @db.TinyText
  value  String @db.Text

  @@map("action_field")
}

// Effects are the connection between an action and a goal, showing how the action affects the goal
model Effect {
  // Timestamp of when effect was created
  createdAt DateTime @default(now()) @map("created_at")
  // Timestamp of when effect was last updated
  updatedAt DateTime @updatedAt @map("updated_at")

  // Data series representing the impact of the related action on the goal, year by year
  dataSeriesId String?     @unique @map("data_series_id")
  dataSeries   DataSeries? @relation(name: "effect_data_series", fields: [dataSeriesId], references: [id])

  // The type of impact this action has, affects how the data series is interpreted
  impactType ActionImpactType @default(ABSOLUTE) @map("impact_type")

  // The action this effect is related to
  actionId String @map("action_id")
  action   Action @relation("action_effect", fields: [actionId], references: [id], onDelete: Cascade)
  // The goal this effect is related to
  goalId   String @map("goal_id")
  goal     Goal   @relation("goal_effect", fields: [goalId], references: [id], onDelete: Cascade)

  @@id(name: "id", [actionId, goalId])
  @@map("effect")
}

// There is apparently a default typescript interface called "Comment", so make sure to properly import this type in the code
model Comment {
  // UUID of the comment
  id        String   @id @default(uuid())
  // Timestamp of when comment was created
  createdAt DateTime @default(now()) @map("created_at")
  // Timestamp of when comment was last updated
  updatedAt DateTime @updatedAt @map("updated_at")

  // The comment itself
  commentText String @map("comment_text") @db.Text

  // The user who created this comment
  authorId String? @map("author_id")
  author   User?   @relation("comment_author", fields: [authorId], references: [id], onDelete: SetNull)

  // A comment should be related to either an action, a goal, a roadmap, XOR a meta roadmap.
  // Has to be enforced in the code, as prisma does not support custom constraints and many SQL implementations
  // do not support check constraints on columns with referential actions.
  // Any action this comment is related to
  actionId      String?      @map("action_id")
  action        Action?      @relation("action_comment", fields: [actionId], references: [id], onDelete: Cascade)
  // Any goal this comment is related to
  goalId        String?      @map("goal_id")
  goal          Goal?        @relation("goal_comment", fields: [goalId], references: [id], onDelete: Cascade)
  // Any roadmap this comment is related to
  roadmapId     String?      @map("roadmap_id")
  roadmap       Roadmap?     @relation("roadmap_comment", fields: [roadmapId], references: [id], onDelete: Cascade)
  // Any meta roadmap this comment is related to
  metaRoadmapId String?      @map("meta_roadmap_id")
  metaRoadmap   MetaRoadmap? @relation("meta_roadmap_comment", fields: [metaRoadmapId], references: [id], onDelete: Cascade)

  @@map("comment")
}

model Org {
  id     String  @id @default(uuid())
  name   String  @unique
  domain String? @unique

  memberships    OrgMembership[]
  groups         Group[]         @relation("org_group")
  accessControls AccessControl[]

  dataSeries DataSeries[]
  recipes    Recipe[]
  actions    Action[]

  @@map("org")
}

model Group {
  id   String @id @default(uuid())
  name String

  orgId String @map("org_id")
  org   Org    @relation("org_group", fields: [orgId], references: [id], onDelete: Cascade)

  memberships GroupMembership[]
  grants      AccessGrant[]

  @@unique([orgId, name]) // Unique group names within an org
  // Referenced by GroupMembership's composite FK to keep group and org membership in the same org
  @@unique([id, orgId])
  @@map("group")
}

// A user's membership in an org; group memberships hang off this so they die with it
model OrgMembership {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String @map("org_id")
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  role OrgRole @default(MEMBER)

  groupMemberships GroupMembership[]

  @@unique([userId, orgId]) // No dupe memberships for the same user in the same org
  // Referenced by GroupMembership's composite FK
  @@unique([id, orgId])
  @@map("org_membership")
}

// Membership in a group, tied to an org membership rather than a user directly:
// leaving the org cascades away all group memberships in it, and the shared orgId
// in both composite FKs makes cross-org group membership unrepresentable
model GroupMembership {
  membershipId String @map("membership_id")
  orgId        String @map("org_id")
  groupId      String @map("group_id")

  membership OrgMembership @relation(fields: [membershipId, orgId], references: [id, orgId], onDelete: Cascade)
  group      Group         @relation(fields: [groupId, orgId], references: [id, orgId], onDelete: Cascade)

  @@id([membershipId, groupId])
  @@map("group_membership")
}

model AccessControl {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // The org that owns the attached items; its managers have implicit full access
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // If public, it grants read access to everyone (account or not) regardless of grants
  isPublic    Boolean @default(false) @map("is_public")
  // If org readable, all members of the owning org get read access; disable together with isPublic for org-internal need-to-know objects
  orgReadable Boolean @default(true) @map("org_readable")

  grants AccessGrant[]

  metaRoadmaps MetaRoadmap[]

  // Referenced by AccessGrant's composite FK to keep grants within the owning org
  @@unique([id, orgId])
  @@map("access_control")
}

// Grants all members of a group an access level on the objects attached to an access control.
// Both composite FKs carry orgId, so a grant can only pair a group and an access control from the same org;
// cross-org contributors instead get a GUEST org membership and a spot in a group of the owning org.
model AccessGrant {
  accessControlId String @map("access_control_id")
  groupId         String @map("group_id")
  orgId           String @map("org_id")

  accessControl AccessControl @relation(fields: [accessControlId, orgId], references: [id, orgId], onDelete: Cascade)
  group         Group         @relation(fields: [groupId, orgId], references: [id, orgId], onDelete: Cascade)

  accessLevel AccessLevel @default(RO) @map("access_level")

  @@id([accessControlId, groupId])
  @@map("access_grant")
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  email        String  @unique
  passwordHash String  @map("password") // Rename to old column name
  isVerified   Boolean @default(false) @map("is_verified") // Has verified email

  isSuperAdmin Boolean @default(false) @map("is_admin")

  memberships OrgMembership[]

  // Authorship (purely visual/cool to know, not auth)
  authoredActions      Action[]      @relation("action_author")
  authoredGoals        Goal[]        @relation("goal_author")
  authoredRoadmaps     Roadmap[]     @relation("roadmap_author")
  authoredMetaRoadmaps MetaRoadmap[] @relation("meta_roadmap_author")
  authoredDataSeries   DataSeries[]  @relation("data_series_author")
  authoredComments     Comment[]     @relation("comment_author")

  @@map("user")
}
