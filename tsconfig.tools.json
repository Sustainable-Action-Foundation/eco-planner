{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@prisma/client": [
        "./src/prisma/generated"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "./scripts/**/*.ts",
    "./scripts/**/*.tsx",
    "./tests/**/*.ts",
    "./tests/**/*.tsx"
  ]
}